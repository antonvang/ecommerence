+# ---------- close states v2 (director order 81; research/desk/OBSERVABILITY_81.md) ----------
+# A close that cannot finish is recorded as such: one append-only event per change of state, read back after a restart.
+# Nothing is priced, closed or marked without a real book, and a terminal state never resumes by itself. TERMINAL does not
+# mean closed: `closed` is true only with CLOSE_SUCCESS. A leg whose partner has no book is not closed either: that needs a
+# separate decision.
+CLOSE_STATE = "paper.close_state"
+CLOSE_SUCCESS = "CLOSE_SUCCESS"
+PARTIAL_RETRYING, PARTIAL_TERMINAL = "PARTIAL_CLOSE_RETRYING", "PARTIAL_CLOSE_TERMINAL"
+INCOMPLETE_RETRYING, INCOMPLETE_TERMINAL = "CLOSE_INCOMPLETE_RETRYING", "CLOSE_INCOMPLETE_TERMINAL"
+TERMINAL_CLOSE_STATES = (PARTIAL_TERMINAL, INCOMPLETE_TERMINAL)
+CLOSE_RETRY_MAX_S = 7 * 86400          # provisional dev test default (order 81); not a stop rule
+PERMANENT_UNAVAILABLE_SUFFIXES = (SPOT_SUFFIX,)   # order 76: the spot book host is permanently unavailable
+CLOSE_RULE = "director order 81 (research/desk/OBSERVABILITY_81.md)"
+
+
+def permanently_unavailable(sym):
+    return sym.endswith(tuple(PERMANENT_UNAVAILABLE_SUFFIXES))
+
+
+def _leg_base(sym):
+    if sym.startswith(HL_PREFIX):
+        return sym[len(HL_PREFIX):] + "USDT"
+    return sym[:-len(SPOT_SUFFIX)] if sym.endswith(SPOT_SUFFIX) else sym
+
+
+def blocked_legs(positions):
+    """Open legs that are not read or closed: the permanently unavailable ones and the legs paired with them."""
+    bases = {_leg_base(s) for s in positions if permanently_unavailable(s)}
+    return {s for s in positions if _leg_base(s) in bases}
+
+
+def close_state_of(open_legs, reduced, last_fill_ts, last_mark_ts, blocked, expired):
+    """The one place a close state is decided. No I/O. CLOSE_SUCCESS needs no open leg and a mark at or after the last
+    fill; anything else is a failure state, terminal once no open leg can still be closed or the retry time is spent."""
+    if not open_legs:
+        if last_fill_ts is not None and last_mark_ts is not None and last_mark_ts >= last_fill_ts:
+            return CLOSE_SUCCESS
+        return INCOMPLETE_TERMINAL if expired else INCOMPLETE_RETRYING
+    terminal = expired or all(s in blocked for s in open_legs)
+    if reduced:
+        return PARTIAL_TERMINAL if terminal else PARTIAL_RETRYING
+    return INCOMPLETE_TERMINAL if terminal else INCOMPLETE_RETRYING
+
+
+def _close_last(db, led):
+    r = db.one("SELECT payload FROM events WHERE kind=? AND exp_id=? ORDER BY id DESC LIMIT 1", CLOSE_STATE, led)
+    return _payload(r["payload"]) if r else {}
+
+
+def _note_close_state(db, eng, led, now):
+    """The ledger's close state now; one paper.close_state event only when it differs from the last one."""
+    with db.tx():                                      # BEGIN IMMEDIATE: one check and one write
+        last = _close_last(db, led)
+        first = int(last.get("first_ts") or now)
+        pos = eng.ledger(led)["positions"]
+        touched = {r[0] for r in db.q("SELECT DISTINCT f.instrument FROM sim_fills f JOIN sim_orders o ON "
+                                      "o.order_id=f.order_id WHERE f.exp_id=? AND o.reduce_only=1 AND o.order_id LIKE ?",
+                                      led, f"{led}|close|%")}
+        last_fill = db.one("SELECT MAX(ts) FROM sim_fills WHERE exp_id=?", led)[0]
+        last_mark = db.one("SELECT MAX(ts) FROM sim_equity WHERE exp_id=?", led)[0]
+        blocked = blocked_legs(pos)
+        state = close_state_of(sorted(pos), touched, last_fill, last_mark, blocked,
+                               int(now) - first >= CLOSE_RETRY_MAX_S)
+        flat = sorted(touched - set(pos))
+        bases = {_leg_base(s) for s in flat}
+        p = {"ledger": led, "state": state, "closed": state == CLOSE_SUCCESS, "t": int(now), "first_ts": first,
+             "open_legs": sorted(pos), "closed_legs": flat,
+             "unpaired_open_legs": sorted(s for s in pos if _leg_base(s) in bases),
+             "permanent_legs": sorted(s for s in pos if permanently_unavailable(s)), "blocked_legs": sorted(blocked),
+             "requires_decision": state in TERMINAL_CLOSE_STATES, "retry_deadline_ts": first + CLOSE_RETRY_MAX_S,
+             "last_fill_ts": last_fill, "last_mark_ts": last_mark, "simulated": True, "rule": CLOSE_RULE}
+        same = all(last.get(k) == p[k] for k in ("state", "open_legs", "closed_legs", "blocked_legs"))
+        if not same:
+            db.event(CLOSE_STATE, "agent:paper-1", led, p)
+    return last if same else p
+
+
