+POST_TERMINAL_STATES = ("PARTIAL_CLOSE_TERMINAL", "CLOSE_INCOMPLETE_TERMINAL")   # candidate 83 (ORDER83.md)
+
+
+def post_terminal(con, led, lim, mark=None):
+    """Candidate 83: funding booked after the account's close went terminal (the paper.close_state cutoff by
+    sim_funding id). Reported apart: never strategy performance, never validated. Every row is in one bucket only."""
+    row = con.execute("SELECT payload FROM events WHERE kind='paper.close_state' AND exp_id=? AND "
+                      "json_extract(payload, '$.t')<=? ORDER BY id DESC LIMIT 1", (led, lim)).fetchone()
+    p = json.loads(row[0]) if row else {}
+    none = {"terminal": False, "amount": 0.0, "rows": 0, "at_mark": 0.0, "by_instrument": {}, "late_settlements": 0,
+            "in_strategy_performance": False, "validated": False}
+    if p.get("state") not in POST_TERMINAL_STATES or p.get("funding_id_at_terminal") is None:
+        return none
+    cut, t = int(p["funding_id_at_terminal"]), p.get("terminal_ts")
+    rows = con.execute("SELECT id, ts, settle_ts, instrument, amount FROM sim_funding WHERE exp_id=? AND id>? AND ts<=? "
+                       "ORDER BY id", (led, cut, lim)).fetchall()
+    by = collections.defaultdict(float)
+    for _, _, _, sym, amount in rows:
+        by[sym] += amount
+    return {**none, "terminal": True, "state": p["state"], "terminal_ts": t, "cutoff_funding_id": cut,
+            "amount": sum(r[4] for r in rows), "rows": len(rows), "ids": [r[0] for r in rows],
+            "at_mark": sum(r[4] for r in rows if mark is not None and r[1] <= mark), "by_instrument": dict(by),
+            "late_settlements": sum(1 for r in rows if t is not None and r[2] < t)}
+
+
