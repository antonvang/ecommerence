+def data_activity_age(path, now=None):
+    """Seconds since the collector stored a successful poll or status row. A fresh file alone proves nothing: a failed
+    start also writes to it. None = no readable database. Short read-only look at the newest rows only."""
+    now = now or time.time()
+    if not os.path.exists(path):
+        return None
+    con = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=1)
+    try:
+        con.execute("PRAGMA query_only=ON")
+        rows = con.execute("SELECT t, ok FROM polls ORDER BY rowid DESC LIMIT 2000").fetchall()
+        status = con.execute("SELECT t FROM status ORDER BY rowid DESC LIMIT 1").fetchone()
+    except sqlite3.Error:
+        return None
+    finally:
+        con.close()
+    good = [t for t, ok in rows if ok] + ([status[0]] if status else [])
+    newest = max(good) if good else min((t for t, _ in rows), default=None)  # all failed: at least this long ago
+    return None if newest is None else now - newest
+
