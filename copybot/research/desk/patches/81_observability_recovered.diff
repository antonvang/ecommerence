+# Order 81, on top of the 72 patch: a poll or status row is activity, but recovery needs every source the study depends
+# on. pm_lp's books come from another host than its trade polls, so trade polls alone must not read as healthy.
+EXTERNAL_REQUIRED = {"X01_pm_lp_v1": (
+    ("book snapshots", "SELECT t FROM snaps ORDER BY rowid DESC LIMIT 1"),
+    ("trade polls", "SELECT t FROM polls WHERE ok=1 AND kind='trades' AND rowid > "
+                    "(SELECT COALESCE(MAX(rowid), 0) - 2000 FROM polls) ORDER BY rowid DESC LIMIT 1"))}
+
+
+def required_data_age(path, sources, now=None):
+    """{"age": seconds since the OLDEST required source last delivered a valid row, "sources": {name: age}}. A source
+    with no valid row counts as never (age = now). None if the database cannot be read: that decides nothing."""
+    now = now or time.time()
+    if not os.path.exists(path):
+        return None
+    con = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=1)
+    try:
+        con.execute("PRAGMA query_only=ON")
+        ages = {}
+        for name, sql in sources:
+            row = con.execute(sql).fetchone()
+            ages[name] = now - (row[0] if row and row[0] is not None else 0)
+    except sqlite3.Error:
+        return None
+    finally:
+        con.close()
+    return {"age": max(ages.values()) if ages else None, "sources": ages}
+
