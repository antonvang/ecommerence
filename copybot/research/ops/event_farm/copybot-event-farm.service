[Unit]
Description=Copybot event farm forward PAPER book (PROTOCOL_V3 amendment 46; paper only, no orders)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/anton/copybot-dev/copybot
ExecStart=/usr/bin/python3 -u -m research.tools.event_farm_run run
Restart=on-failure
RestartSec=60
# 2 = gate closed, 3 = integrity halt, 4 = call log broken, 5 = code changed: stay stopped for a human
RestartPreventExitStatus=2 3 4 5
Nice=10
IOSchedulingClass=idle
MemoryMax=256M
CPUQuota=20%

[Install]
WantedBy=default.target
